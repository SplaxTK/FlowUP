# URL pública do site, SEM barra no final. Usada nos links enviados por e-mail.
# Vercel: https://seu-projeto.vercel.app  |  XAMPP: http://localhost/FlowUp/site
APP_URL="https://seu-projeto.vercel.app"


# Configurações de ambiente para o projeto FlowUp
# Defina a senha do banco de dados aqui.
SENHA="sua_senha_aqui"

# Defina a chave secreta para geração de tokens JWT aqui.
JWT_SECRET_KEY="sua_chave_ultrasecreta_aqui"

# Defina a chave da API do Resend aqui.
RESEND_API_KEY="re_sua_chave_aqui"

# Depois de verificar um domínio no Resend, troque por ex.: FlowUp <nao-responda@seudominio.com>
RESEND_FROM="FlowUp <onboarding@resend.dev>"

# ===========================
# Upd futuro
# ===========================

GOOGLE_CLIENT_ID="Sua_senha_aqui"

GOOGLE_CLIENT_SECRET="Sua_senha_aqui"

GOOGLE_REDIRECT_URI="Sua_senha_aqui"

APP_ENCRYPTION_KEY="Sua_senha_aqui"

APP_TIMEZONE="Sua_senha_aqui"